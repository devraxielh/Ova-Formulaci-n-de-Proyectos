# Copia este archivo como .env y completa los valores
PORT=8787
NODE_ENV=production
APP_URL=https://projectsia.aplicaciones.digital

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Administrador inicial (se crea una sola vez; debe cambiar la contraseña al entrar)
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=admin

# Correo para enlaces de activación (por ejemplo, una cuenta de correo de Hostinger)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PROJECTSIA <no-responder@aplicaciones.digital>

# Clave gratuita de OpenAlex para la búsqueda de artículos (https://openalex.org/settings/api)
OPENALEX_API_KEY=

# Clave opcional de Semantic Scholar (https://www.semanticscholar.org/product/api#api-key-form)
SEMANTIC_SCHOLAR_API_KEY=

# Clave de Rulex Data para buscar normas y jurisprudencia en el Marco legal (https://rulex.org/docs/api)
RULEX_API_KEY=
